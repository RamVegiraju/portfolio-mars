---
import '../styles/global.css';
import { navigation } from '../data/navigation';
import { getImage } from 'astro:assets';
import profile from '../assets/profile.png';
const profileImage = await getImage({ src: profile, width: 800, height: 800, fit: 'cover', format: 'webp' });
interface Props { title?: string; description?: string; active?: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; publishedTime?: string; }
const { title = 'Ram Vegiraju — Work, words & everything else', description = 'A personal home for my work in AI/ML, boxing, writing, videos, and life in New York in my 20s.', active = '', image = profileImage.src, imageAlt = 'Ram Vegiraju', type = 'website', publishedTime } = Astro.props;
const pageTitle = title.includes('Ram Vegiraju') ? title : `${title} — Ram Vegiraju`;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10151D" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Ram Vegiraju's writing" href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Ram Vegiraju" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, canonical).href} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="wordmark" href="/" aria-label="Ram Vegiraju home">ram<span>.</span></a>
      <nav aria-label="Main navigation">
        {navigation.map(({href,title,key}) => <a href={href} aria-current={active === key ? 'page' : undefined}>{title}</a>)}
      </nav>
      <div class="header-actions">
        <a class="resume-link" href="/resume.pdf" target="_blank" rel="noopener">Resume <span class="file-label">PDF</span></a>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to light mode" title="Switch color theme">
          <svg class="sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          <svg class="moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 15A8 8 0 0 1 9 4a8.5 8.5 0 1 0 11 11Z"/></svg>
        </button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div><a class="wordmark" href="/">ram<span>.</span></a><p>Work, writing, and interests.</p></div>
      <div class="footer-links"><a href="https://github.com/RamVegiraju">GitHub</a><a href="https://www.youtube.com/@RamVegiraju">YouTube</a><a href="https://www.linkedin.com/in/ram-vegiraju-81272b162/">LinkedIn</a><a href="/rss.xml">RSS</a></div>
      <p class="copyright">© {new Date().getFullYear()} Ram Vegiraju</p>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const update = () => { const light = document.documentElement.dataset.theme === 'light'; button?.setAttribute('aria-label', `Switch to ${light ? 'dark' : 'light'} mode`); button?.setAttribute('aria-pressed', String(light)); };
      update();
      button?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light'; document.documentElement.dataset.theme = next; try { localStorage.setItem('theme',next); } catch {} update(); });
    </script>
  </body>
</html>
