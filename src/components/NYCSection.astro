---
import NYCMap from './NYCMap.astro';
import { city } from '../data/nyc';
import { placeUrl } from '../lib/nyc-favorites';
import type { Restaurant, NightlifePlace, CityMoment } from '../lib/nyc-favorites';

const restaurants: Restaurant[] = city.restaurants;
const nightlife: NightlifePlace[] = city.nightlife;
const moments: CityMoment[] = city.moments;
const cuisines = ['All cuisines', ...new Set(restaurants.map(place => place.cuisine).filter(Boolean))];
const nightlifeCategories = ['Speakeasies & cocktails', 'Clubs & venues'] as const;
---
<div class="container city-page">
  <section class="city-intro" aria-label="My life in New York">
    {city.intro.map(paragraph => <p>{paragraph}</p>)}
    <nav class="city-jump-links" aria-label="NYC page sections"><a href="#where-ive-lived">Where I’ve lived</a><a href="#restaurants">Restaurants</a><a href="#nightlife">Nightlife</a>{moments.length > 0 && <a href="#city-moments">Moments</a>}</nav>
  </section>
  <section id="where-ive-lived" class="city-section" aria-labelledby="neighborhoods-heading"><div class="section-heading"><h2 id="neighborhoods-heading">Where I’ve lived</h2><span class="section-detail">2022–Present</span></div><NYCMap /></section>
  <section id="restaurants" class="city-section" aria-labelledby="restaurants-heading">
    <div class="section-heading"><h2 id="restaurants-heading">Favorite restaurants</h2><span class="section-detail">By cuisine</span></div>
    {restaurants.length > 0 ? <>
      <div class="restaurant-toolbar" data-restaurant-controls hidden>
        <div class="cuisine-filters" role="group" aria-label="Filter restaurants by cuisine">{cuisines.map(cuisine => <button type="button" data-cuisine={cuisine} aria-pressed={cuisine === 'All cuisines'}>{cuisine}</button>)}</div>
        <label class="restaurant-search"><span class="sr-only">Search restaurants</span><input type="search" placeholder="Find a restaurant" /></label>
      </div>
      <p class="restaurant-count" data-restaurant-count aria-live="polite">{restaurants.length} {restaurants.length === 1 ? 'restaurant' : 'restaurants'}</p>
      <div class="restaurant-list">{restaurants.map(place => <article class="place-row" data-restaurant={JSON.stringify(place)}><div class="place-details"><span class="place-category">{place.cuisine}</span><h3>{place.name}</h3>{place.neighborhood && <p class="place-neighborhood">{place.neighborhood}</p>}</div><div class="place-note">{place.note && <p>{place.note}</p>}{placeUrl(place.url) && <a class="text-link" href={placeUrl(place.url)} target="_blank" rel="noopener noreferrer">Visit {place.name}</a>}</div></article>)}</div>
      <p class="filter-empty" data-restaurant-empty hidden>No restaurants match this search. Try another cuisine or name.</p>
    </> : <div class="favorites-empty"><p>Restaurant list not added yet.</p></div>}
  </section>
  <section id="nightlife" class="city-section" aria-labelledby="nightlife-heading">
    <div class="section-heading"><h2 id="nightlife-heading">Nightlife</h2></div>
    <div class="nightlife-groups">{nightlifeCategories.map(category => <section class="nightlife-group"><h3>{category}</h3>{nightlife.filter(place => place.category === category).length > 0 ? <ul>{nightlife.filter(place => place.category === category).map(place => <li><h4>{place.name}</h4>{place.neighborhood && <p class="place-neighborhood">{place.neighborhood}</p>}{place.note && <p>{place.note}</p>}{placeUrl(place.url) && <a class="text-link" href={placeUrl(place.url)} target="_blank" rel="noopener noreferrer">Visit {place.name}</a>}</li>)}</ul> : <p class="favorites-empty">No places added yet.</p>}</section>)}</div>
  </section>
  {moments.length > 0 && <section id="city-moments" class="city-section" aria-labelledby="moments-heading"><div class="section-heading"><h2 id="moments-heading">Moments in the city</h2></div><div class="city-moments">{moments.map(moment => <figure><img src={moment.image} alt={moment.alt} width="1200" height="900" loading="lazy" /><figcaption>{moment.caption}</figcaption></figure>)}</div></section>}
</div>
<script>
  import { matchesRestaurant } from '../lib/nyc-favorites';
  import type { Restaurant } from '../lib/nyc-favorites';
  const controls = document.querySelector<HTMLElement>('[data-restaurant-controls]');
  if (controls) {
    controls.hidden = false;
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>('[data-cuisine]')];
    const search = controls.querySelector<HTMLInputElement>('input');
    const rows = [...document.querySelectorAll<HTMLElement>('[data-restaurant]')].map(element => ({ element, place: JSON.parse(element.dataset.restaurant || '{}') as Restaurant }));
    let cuisine = 'All cuisines';
    const update = () => {
      let count = 0;
      rows.forEach(({element, place}) => { const visible = matchesRestaurant(place, cuisine, search?.value || ''); element.hidden = !visible; if (visible) count++; });
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.cuisine === cuisine)));
      document.querySelector<HTMLElement>('[data-restaurant-count]')!.textContent = `${count} ${count === 1 ? 'restaurant' : 'restaurants'}`;
      document.querySelector<HTMLElement>('[data-restaurant-empty]')!.hidden = count > 0;
    };
    buttons.forEach(button => button.addEventListener('click', () => { cuisine = button.dataset.cuisine || 'All cuisines'; update(); }));
    search?.addEventListener('input', update);
  }
</script>
<style>
  .city-intro{max-width:850px;margin-bottom:3.5rem}.city-intro>p{font-size:1.075rem;line-height:1.95;margin-bottom:1.5rem}.city-jump-links{display:flex;flex-wrap:wrap;gap:1rem 2rem;margin-top:2.2rem}.city-jump-links a{font-size:.9rem;color:var(--accent);text-decoration:underline;text-underline-offset:5px}.city-section{padding-top:3rem;margin-top:1rem;border-top:1px solid var(--border);padding-bottom:2.5rem;scroll-margin-top:2rem}.section-detail{font-size:.875rem;color:var(--muted)}.restaurant-toolbar{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;margin:1.5rem 0}.cuisine-filters{display:flex;flex-wrap:wrap;gap:.6rem}.cuisine-filters button{background:transparent;border:1px solid var(--border);border-radius:30px;color:var(--muted);padding:.5rem .9rem;font-size:.875rem;min-height:42px}.cuisine-filters button[aria-pressed=true]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}.restaurant-search input{max-width:100%;font-size:.9rem;background:transparent;border:0;border-bottom:1px solid var(--border);color:var(--text);padding:.65rem 0;width:230px}.restaurant-search input::placeholder{color:var(--muted)}.restaurant-count{font-size:.875rem}.place-row{display:grid;grid-template-columns:1fr 1.6fr;gap:2rem;border-top:1px solid var(--border);padding:1.8rem 0}.place-category{font-size:.875rem;color:var(--accent)}.place-details h3{font-family:var(--serif);font-size:2rem;margin:.7rem 0}.place-neighborhood{font-size:.875rem;margin-bottom:.8rem}.place-note p{font-size:1rem;line-height:1.85}.favorites-empty{border:1px solid var(--border);border-radius:6px;padding:1.5rem;font-size:1rem;color:var(--muted)}.favorites-empty p{margin:0}.nightlife-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3rem}.nightlife-group>h3{font-family:var(--serif);font-size:2rem;margin-bottom:1.5rem}.nightlife-group ul{list-style:none;margin:0;padding:0}.nightlife-group li{padding:1.5rem 0;border-top:1px solid var(--border)}.nightlife-group h4{font-size:1.1rem;font-weight:500;margin:0 0 .7rem}.nightlife-group li>p{line-height:1.8}.filter-empty{padding:2rem 0}.city-moments{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem}.city-moments figure{margin:0}.city-moments img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:6px}.city-moments figcaption{font-size:.875rem;color:var(--muted);line-height:1.8;margin-top:.8rem}[hidden]{display:none!important}
  @media(max-width:760px){.city-intro>p{font-size:1rem}.city-jump-links{gap:1rem 1.5rem}.city-section{padding-top:2.5rem}.nightlife-groups,.place-row,.city-moments{grid-template-columns:1fr;gap:1.5rem}.restaurant-search,.restaurant-search input{width:100%}.section-heading{align-items:baseline}.nightlife-groups{gap:2.5rem}}
</style>
