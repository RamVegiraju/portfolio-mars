---
import { Image } from 'astro:assets';
import firstDay from '../assets/boxing/first-day-january-2024.png';
import sparringPhoto from '../assets/boxing/sparring.png';
import journey from '../data/boxing-journey.json';
---
<section class="container boxing-journey" aria-label="My boxing journey from 2024 to my goal for 2027">
  <p class="journey-opening">{journey.opening}</p>
  <ol class="journey-timeline">
    {journey.milestones.map(milestone => <li class="timeline-entry" id={milestone.id}>
      <div class="milestone-period"><span>{milestone.period}</span></div>
      <div class="milestone-content">
        <h2>{milestone.title}</h2>
        {milestone.id === 'first-day' ? <div class="first-day-layout"><div>{milestone.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div><figure class="first-day-photo"><Image src={firstDay} alt="Ram at Church Street Boxing Gym on his first day in January 2024, wearing a yellow shirt." width={600} widths={[320,600]} sizes="(max-width:760px) 280px, 300px" format="webp" loading="lazy" /><figcaption>My first day at Church Street.<br />January 2024.</figcaption></figure></div> : milestone.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        {milestone.id === 'first-sparring' && <div class="early-sparring">
          <figure class="training-clip">
            <div class="clip-label"><h3>One of the first rounds</h3><span>Late 2024 · 2 min 17 sec</span></div>
            <video controls playsinline preload="none" poster="/media/boxing/sparring-late-2024-poster.jpg" width="960" height="540" aria-label="One of my first times sparring, late 2024" aria-describedby="sparring-2024-description">
              <source src="/media/boxing/sparring-late-2024.mp4" type="video/mp4" />
              <a href="/media/boxing/sparring-late-2024.mp4">Open the late-2024 sparring video</a>
            </video>
            <figcaption id="sparring-2024-description">One of my first times ever sparring, if it wasn’t obvious enough lol.</figcaption>
            <a class="clip-direct-link" href="/media/boxing/sparring-late-2024.mp4">Open late-2024 sparring video</a>
          </figure>
          <aside class="coach-note" aria-labelledby="coach-heading"><span class="eyebrow">My coach</span><h3 id="coach-heading">In my corner.</h3><p>You can hear my coach, <a href={journey.coach.instagramUrl} target="_blank" rel="noopener noreferrer">{journey.coach.name}</a>, in the background.</p><p>{journey.coach.note}</p><a class="text-link" href={journey.coach.instagramUrl} target="_blank" rel="noopener noreferrer">@scrapologyboxing on Instagram</a></aside>
        </div>}
        {milestone.id === 'getting-serious' && <figure class="training-clip earlier-sparring">
          <div class="clip-label"><h3>Sparring</h3><span>2025 · 30 seconds</span></div>
          <video controls playsinline preload="none" poster="/media/boxing/sparring-2025-poster.jpg" width="1280" height="720" aria-label="Sparring, 2025" aria-describedby="sparring-2025-description">
            <source src="/media/boxing/sparring-2025.mp4" type="video/mp4" />
            <a href="/media/boxing/sparring-2025.mp4">Open the 2025 sparring video</a>
          </video>
          <figcaption id="sparring-2025-description">Sparring in 2025, as I started taking the sport more seriously.</figcaption>
          <a class="clip-direct-link" href="/media/boxing/sparring-2025.mp4">Open 2025 sparring video</a>
        </figure>}
        {milestone.id === 'putting-in-rounds' && <div class="training-media">
          <figure class="sparring-photo"><Image src={sparringPhoto} alt="Two boxers sparring in the ring, wearing headgear and gloves." width={1200} height={675} fit="cover" format="webp" loading="lazy" /><figcaption>A moment from sparring. Hundreds of rounds in, still learning.</figcaption></figure>
          <div class="training-clips">
            <figure class="training-clip landscape">
              <div class="clip-label"><h3>Sparring</h3><span>2026 · 57 seconds</span></div>
              <video controls playsinline preload="none" poster="/media/boxing/sparring-2026-poster.jpg" width="1280" height="720" aria-label="Sparring, 2026" aria-describedby="sparring-description">
                <source src="/media/boxing/sparring-2026.mp4" type="video/mp4" />
                <a href="/media/boxing/sparring-2026.mp4">Open the 2026 sparring video</a>
              </video>
              <figcaption id="sparring-description">A clip from sparring in 2026. More rounds in the ring, with plenty left to learn.</figcaption>
              <a class="clip-direct-link" href="/media/boxing/sparring-2026.mp4">Open sparring video</a>
            </figure>
            <figure class="training-clip portrait">
              <div class="clip-label"><h3>Mitt work</h3><span>2026 · 30 seconds</span></div>
              <video controls playsinline preload="none" poster="/media/boxing/mitts-2026-poster.jpg" width="720" height="1280" aria-label="Mitt work, 2026" aria-describedby="mitts-description">
                <source src="/media/boxing/mitts-2026.mp4" type="video/mp4" />
                <a href="/media/boxing/mitts-2026.mp4">Open the 2026 mitt-work video</a>
              </video>
              <figcaption id="mitts-description">A mitt-work session from 2026. Another part of the work between rounds.</figcaption>
              <a class="clip-direct-link" href="/media/boxing/mitts-2026.mp4">Open mitt-work video</a>
            </figure>
          </div>
        </div>}
      </div>
    </li>)}
  </ol>
  <aside class="training-archive">
    <div><span class="eyebrow">The older training archive</span><h2>A few earlier chapters.</h2><p>I used to share training videos on Instagram, too. There are more clips from the journey over there.</p></div>
    <a class="button secondary" href={journey.instagramUrl} target="_blank" rel="noopener noreferrer">@ramv_boxing on Instagram</a>
  </aside>
</section>
<style>
  .early-sparring{margin-top:2rem}.coach-note{margin-top:1.7rem;padding:1.6rem 1.8rem;background:var(--surface);border-left:2px solid var(--accent);border-radius:0 6px 6px 0}.coach-note .eyebrow{margin-bottom:.7rem}.coach-note h3{font-family:var(--serif);font-size:2rem;font-weight:400;margin-bottom:1rem}.coach-note p{font-size:1rem;margin-bottom:1rem}.coach-note p a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  .boxing-journey{padding-top:.5rem}.journey-opening{font-family:var(--serif);font-size:clamp(1.7rem,3.5vw,2.4rem);font-weight:400;line-height:1.4;color:var(--accent);max-width:810px;margin:0 0 3.5rem}.journey-timeline{list-style:none;margin:0;padding:0}.timeline-entry{display:grid;grid-template-columns:150px minmax(0,1fr);gap:2rem;position:relative}.timeline-entry::before{content:'';position:absolute;left:181px;top:.9rem;bottom:-.9rem;border-left:1px solid var(--border)}.timeline-entry:last-child::before{bottom:3rem}.milestone-period{padding-top:.5rem;color:var(--accent);font-size:.875rem;line-height:1.6;font-weight:500}.milestone-content{padding-left:2.5rem;padding-bottom:4rem;position:relative;min-width:0}.milestone-content::before{content:'';position:absolute;top:.9rem;left:-8px;width:16px;border-top:1px solid var(--accent)}.milestone-content h2{font-family:var(--serif);font-size:clamp(2rem,3.3vw,2.8rem);font-weight:400;line-height:1.15;margin-bottom:1.5rem;max-width:720px}.milestone-content p{font-size:1.05rem;line-height:1.9;max-width:750px;margin-bottom:1.4rem}.first-day-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,.8fr);gap:2.5rem;align-items:start}.first-day-photo{max-width:300px;margin:0 auto}.first-day-photo :global(img){width:100%;height:auto;border-radius:18px;border:1px solid var(--border)}figure{margin:0}figcaption{font-size:.875rem;line-height:1.7;color:var(--muted);margin-top:.8rem}.training-media{margin-top:2rem}.sparring-photo :global(img){width:100%;height:auto;border-radius:6px}.training-clips{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,.8fr);gap:2rem;margin-top:2.5rem;align-items:start}.clip-label{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;align-items:baseline;margin-bottom:1rem}.clip-label h3{font-size:1.05rem;font-weight:500;margin:0}.clip-label span{font-size:.875rem;color:var(--accent)}video{display:block;width:100%;height:auto;border:1px solid var(--border);border-radius:6px;background:#090c10;object-fit:contain}.landscape video{aspect-ratio:16/9}.portrait video{aspect-ratio:9/16;max-height:510px}.clip-direct-link{font-size:.875rem;color:var(--accent);display:inline-block;margin-top:.7rem;border-bottom:1px solid transparent}.clip-direct-link:hover{border-bottom-color:currentColor}.training-archive{display:flex;justify-content:space-between;align-items:center;gap:2rem;padding:2.5rem;border:1px solid var(--border);border-radius:6px;background:var(--surface)}.training-archive .eyebrow{margin-bottom:.8rem}.training-archive h2{font-family:var(--serif);font-size:2.5rem;font-weight:400;margin-bottom:1rem}.training-archive p{max-width:570px;margin:0;font-size:1rem;line-height:1.8}.training-archive .button{flex-shrink:0}
  @media(max-width:1000px){.timeline-entry{grid-template-columns:110px minmax(0,1fr);gap:1.5rem}.timeline-entry::before{left:133px}.milestone-content{padding-left:1.8rem}.first-day-layout{gap:1.5rem;grid-template-columns:minmax(0,1fr) minmax(190px,.8fr)}.training-clips{gap:1.5rem}.training-archive{align-items:start;flex-direction:column}}
  @media(max-width:760px){.journey-opening{margin-bottom:2.5rem}.timeline-entry{grid-template-columns:1fr;gap:.8rem;padding-left:1.4rem}.timeline-entry::before{left:0;top:.8rem;bottom:-.8rem}.timeline-entry:last-child::before{bottom:2.5rem}.milestone-period{padding-top:0}.milestone-content{padding-left:0;padding-bottom:3rem}.milestone-content::before{top:-1.85rem;left:-1.4rem;width:10px}.milestone-content p{font-size:1rem}.first-day-layout{grid-template-columns:1fr;gap:1rem}.first-day-photo{max-width:280px;margin:0 auto}.training-clips{grid-template-columns:1fr;gap:2rem}.portrait{max-width:340px;width:100%;justify-self:center}.portrait video{max-height:540px}.training-archive{padding:1.5rem}.training-archive h2{font-size:2.1rem}.training-archive .button{white-space:normal;max-width:100%;text-align:center}}
</style>
