---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../content/publication';
import { videos } from '../lib/youtube';
import VideoCard from '../components/VideoCard.astro';
import InterestMap from '../components/InterestMap.astro';
const posts = (await getCollection('posts', ({data}) => isPublished(data))).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
const featured = videos.find(video => video.platform === 'Databricks') || videos[0];
---
<BaseLayout active="home">
  <section class="home-intro container"><span class="eyebrow">AI / ML · Boxing · Life in New York in my 20s</span><h1>Ram Vegiraju<span>.</span></h1><p class="home-description">Hey everyone, I’m Ram. I made this space to share what I’m learning and picking up along the way, from AI/ML and teaching to boxing and life as a 20-something in New York.</p><p class="map-hint">Explore my interests.</p><InterestMap /></section>
  <section class="writing-section container">
    <div class="section-heading"><div><span class="eyebrow">Writing</span><h2>Recent posts</h2></div><a class="text-link" href="/writing/">All writing</a></div>
    <div class="journal-layout">
      <div class="journal-intro"><p>Mostly personal. Sometimes technical. Thoughts on life in New York in my 20s, and what I’m learning, making, and figuring out along the way.</p><div class="topic-list"><span>Life</span><span>Boxing</span><span>AI / ML</span></div></div>
      <div class="post-list">{posts.map(post => <a class="post-row" href={`/writing/${post.id}/`}><div class="post-meta"><span>{post.data.topics.join(' / ')}</span><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="read-label">Read the post</span></a>)}</div>
    </div>
  </section>
  <section class="video-section container">
    <div class="section-heading"><div><span class="eyebrow">YouTube</span><h2>Featured video</h2></div><a class="text-link" href="/videos/">Explore videos</a></div>
    <div class="video-feature">{featured && <VideoCard video={featured} featured />}<div class="video-feature-copy"><span class="eyebrow">On YouTube</span><h3>AWS & Databricks</h3><p>Videos on AI, machine learning, and the tools I work with. Browse recent uploads or follow a learning path through AWS and Databricks.</p><a class="button secondary" href="/videos/?view=paths">Find a learning path</a></div></div>
  </section>

</BaseLayout>
<style>
  .home-intro{padding-top:3rem;text-align:center}.home-intro>.eyebrow{margin-bottom:.6rem}.home-intro h1{font-family:var(--serif);font-size:clamp(3.5rem,6.5vw,5.6rem);letter-spacing:-.035em;font-weight:400;line-height:1.1;margin:.8rem 0 1rem}.home-intro h1 span{color:var(--accent)}.home-description{font-size:1.025rem;line-height:1.8;max-width:660px;margin:0 auto}.map-hint{font-size:.875rem;color:var(--muted);margin:1.6rem 0 -.5rem}.home-intro :global(.interest-map){text-align:left}
  .writing-section{padding-top:4rem;border-top:1px solid var(--border);margin-top:3rem}.journal-layout{display:grid;grid-template-columns:.8fr 1.5fr;gap:6rem}.journal-intro{padding-top:1rem}.journal-intro p{font-size:1rem;line-height:1.9}.topic-list{display:flex;gap:1.3rem;font-size:.875rem;color:var(--accent);margin-top:1.8rem}.post-row{display:block;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:1.6rem 0 1.5rem}.post-meta{display:flex;justify-content:space-between;gap:1rem;font-size:.875rem;margin-bottom:.9rem;color:var(--muted)}.post-meta>span{color:var(--accent)}.post-row h3{font-family:var(--serif);font-size:2rem;margin-bottom:.7rem}.post-row p{font-size:.9rem;max-width:520px;margin-bottom:1.2rem}.read-label{font-size:.875rem;color:var(--accent)}.video-section{padding-top:5.5rem}.video-feature{display:grid;grid-template-columns:1.4fr 1fr;gap:4rem;align-items:center}.video-feature-copy .eyebrow{font-size:.875rem}.video-feature-copy h3{font-family:var(--serif);font-size:2.65rem;font-weight:400;margin-bottom:1.2rem}.video-feature-copy h3 em{color:var(--accent);font-weight:400}.video-feature-copy p{font-size:.9rem;line-height:1.9;margin-bottom:1.6rem}
  @media(max-width:1000px){.journal-layout{gap:3rem}.video-feature{gap:2.5rem}}
  @media(max-width:760px){.home-intro{padding-top:2.3rem}.home-intro>.eyebrow{font-size:.875rem;line-height:1.8;max-width:300px;margin-inline:auto}.home-description{font-size:1rem}.home-intro h1{font-size:clamp(3rem,12vw,4.5rem)}.writing-section,.video-section{padding-top:3rem}.journal-layout,.video-feature{grid-template-columns:1fr;gap:1.8rem}.journal-intro{padding:0}.journal-intro p{margin-bottom:1rem}.topic-list{margin-top:0}.video-feature-copy{max-width:500px}}
</style>
