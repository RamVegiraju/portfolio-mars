---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../content/publication';
import { videos } from '../lib/youtube';
import VideoCard from '../components/VideoCard.astro';
const posts = (await getCollection('posts', ({data}) => isPublished(data))).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
const featured = videos.find(video => video.platform === 'Databricks') || videos[0];
---
<BaseLayout active="home">
  <section class="hero container">
    <div class="hero-copy">
      <span class="eyebrow">AI / ML · Boxing · Life in between</span>
      <h1>Ram Vegiraju<span class="accent">.</span><br /><em>More than work.</em></h1>
      <p class="hero-description">I work on AI and machine learning, make videos, and box. This is where those parts of my life come together.</p>
      <div class="hero-actions"><a class="button" href="/writing/">Explore my writing</a><a class="text-link" href="/about/">A little about me</a></div>
      <div class="currently"><span class="currently-label">THE PROFESSIONAL SIDE</span><p>ML architecture & product at <strong>Databricks</strong><br /><span>Previously AWS · Generative AI instructor</span></p></div>
    </div>
    <div class="portrait-composition">
      <div class="portrait-frame"><img src="/images/ram-vegiraju.jpg" alt="Ram Vegiraju" width="460" height="460" fetchpriority="high" /><span class="portrait-caption">Behind the work, a person.</span></div>
      <div class="portrait-note"><span class="note-line"></span><p>A work in progress.<br /><em>Just like this corner of the internet.</em></p></div>
    </div>
  </section>
  <div class="interest-strip container"><span>Things you’ll find here</span><p>Building with AI <i>·</i> Thinking out loud <i>·</i> Learning in the ring</p></div>
  <section class="writing-section container">
    <div class="section-heading"><div><span class="eyebrow">Notes & longer thoughts</span><h2>From the journal</h2></div><a class="text-link" href="/writing/">All writing</a></div>
    <div class="journal-layout">
      <div class="journal-intro"><p>Mostly personal. Sometimes technical. A place to write about what I’m learning, making, and figuring out.</p><div class="topic-list"><span>Life</span><span>Boxing</span><span>AI / ML</span></div></div>
      <div class="post-list">{posts.map(post => <a class="post-row" href={`/writing/${post.id}/`}><div class="post-meta"><span>{post.data.topics.join(' / ')}</span><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="read-label">Read the post</span></a>)}</div>
    </div>
  </section>
  <section class="video-section container">
    <div class="section-heading"><div><span class="eyebrow">Watch & learn</span><h2>A different way to share</h2></div><a class="text-link" href="/videos/">Explore videos</a></div>
    <div class="video-feature">{featured && <VideoCard video={featured} featured />}<div class="video-feature-copy"><span class="eyebrow">On YouTube</span><h3>Ideas are better<br /><em>when shared.</em></h3><p>Videos on AI, machine learning, and the tools I work with. Browse recent uploads or follow a learning path through AWS and Databricks.</p><a class="button secondary" href="/videos/?view=paths">Find a learning path</a></div></div>
  </section>
  <section class="beyond-section container"><span class="eyebrow">Outside the day job</span><div class="beyond-grid"><h2>There’s a life<br /><em>outside the laptop.</em></h2><div><p>Boxing is part of mine. Alongside the technical work, I want this space to hold more personal reflections, interests, and everyday updates.</p><a class="text-link" href="/writing/?topic=Boxing">Notes on boxing</a></div></div><div class="boxing-word" aria-hidden="true">STILL LEARNING.</div></section>
</BaseLayout>
<style>
  .hero{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:5rem;padding-top:5.5rem;padding-bottom:4rem;align-items:center}.hero-copy .eyebrow{font-size:.875rem;margin-bottom:1.8rem}.hero h1{font-family:var(--serif);font-size:clamp(4.2rem,6.5vw,6.4rem);font-weight:400;letter-spacing:-.03em;line-height:1.02;margin:0 0 1.8rem;white-space:normal;overflow-wrap:break-word}.accent{color:var(--accent)}.hero h1 em{font-weight:400;color:var(--accent)}.hero-description{font-size:1.075rem;max-width:460px;line-height:1.85}.hero-actions{display:flex;align-items:center;gap:1.8rem;margin-top:2rem}.currently{border-top:1px solid var(--border);padding-top:1.6rem;margin-top:2.8rem;max-width:440px}.currently-label{font-size:.64rem;letter-spacing:.13em;color:var(--muted)}.currently p{font-size:.8rem;line-height:1.8;margin-top:.55rem;margin-bottom:0}.currently strong{font-weight:500;color:var(--text)}.currently p span{font-size:.75rem}.portrait-composition{padding:1.3rem 0 0;position:relative}.portrait-frame{position:relative;aspect-ratio:4/4.5;border-radius:5px 80px 5px 5px;overflow:hidden;background:#273238}.portrait-frame img{width:100%;height:100%;object-fit:cover;filter:saturate(.65);object-position:center}.portrait-frame::after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(10,15,22,.85),transparent 35%);pointer-events:none}.portrait-caption{position:absolute;z-index:1;bottom:1.4rem;left:1.6rem;color:#f1f2ef;font-size:.77rem;letter-spacing:.03em}.portrait-note{display:flex;gap:1rem;align-items:center;margin-top:1.5rem;justify-content:end}.portrait-note p{font-size:.73rem;line-height:1.6;margin:0}.portrait-note p em{font-style:normal;color:var(--muted)}.note-line{display:block;width:35px;height:1px;background:var(--accent)}.interest-strip{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:1.2rem 0;gap:1.5rem}.interest-strip>span{font-size:.875rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.interest-strip p{margin:0;font-size:.875rem}.interest-strip i{font-style:normal;margin:0 1rem;color:var(--accent)}.writing-section{padding-top:5rem}.journal-layout{display:grid;grid-template-columns:.8fr 1.5fr;gap:6rem}.journal-intro{padding-top:1rem}.journal-intro p{font-size:1rem;line-height:1.9}.topic-list{display:flex;gap:1.3rem;font-size:.875rem;color:var(--accent);margin-top:1.8rem}.post-row{display:block;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:1.6rem 0 1.5rem}.post-meta{display:flex;justify-content:space-between;gap:1rem;font-size:.7rem;margin-bottom:.9rem;color:var(--muted)}.post-meta>span{color:var(--accent)}.post-row h3{font-family:var(--serif);font-size:2rem;margin-bottom:.7rem}.post-row p{font-size:.9rem;max-width:520px;margin-bottom:1.2rem}.read-label{font-size:.875rem;color:var(--accent)}.video-section{padding-top:5.5rem}.video-feature{display:grid;grid-template-columns:1.4fr 1fr;gap:4rem;align-items:center}.video-feature-copy .eyebrow{font-size:.875rem}.video-feature-copy h3{font-family:var(--serif);font-size:2.65rem;font-weight:400;margin-bottom:1.2rem}.video-feature-copy h3 em{color:var(--accent);font-weight:400}.video-feature-copy p{font-size:.9rem;line-height:1.9;margin-bottom:1.6rem}.beyond-section{position:relative;overflow:hidden;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding-block:3.5rem 4rem;margin-top:5rem}.beyond-grid{display:grid;grid-template-columns:1.25fr 1fr;gap:6rem;position:relative;z-index:1}.beyond-grid h2{font-family:var(--serif);font-size:3.3rem;line-height:1.1;font-weight:400;margin:0}.beyond-grid em{color:var(--accent)}.beyond-grid p{font-size:.95rem;line-height:1.9}.boxing-word{position:absolute;bottom:-3rem;left:0;font-size:7rem;letter-spacing:-.06em;font-weight:700;opacity:.025;white-space:nowrap;pointer-events:none}
  @media(max-width:1000px){.hero{gap:2.5rem}.hero h1{font-size:4.5rem}.journal-layout{gap:3rem}.video-feature{gap:2.5rem}.beyond-grid{gap:3rem}}
  @media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:3rem;gap:2.5rem;padding-bottom:2rem}.hero h1{font-size:clamp(2.9rem,11.5vw,5.6rem)}.hero-description{max-width:100%}.hero-actions{gap:1.4rem}.currently{margin-top:2rem;max-width:100%}.portrait-composition{padding-top:0;max-width:430px;width:100%;margin-inline:auto}.portrait-frame{aspect-ratio:1.1;border-top-right-radius:65px}.portrait-note{margin-top:1rem}.interest-strip{align-items:start;flex-direction:column;gap:.6rem}.interest-strip p{font-size:.875rem}.interest-strip i{margin:0 .4rem}.writing-section,.video-section{padding-top:3.5rem}.journal-layout,.video-feature,.beyond-grid{grid-template-columns:1fr;gap:1.8rem}.journal-intro{padding:0}.journal-intro p{margin-bottom:1rem}.topic-list{margin-top:0}.video-feature-copy{max-width:500px}.beyond-section{margin-top:3.5rem;padding-block:2.5rem 3rem}.beyond-grid h2{font-size:2.8rem}.boxing-word{font-size:5rem;bottom:-2rem}}
</style>
