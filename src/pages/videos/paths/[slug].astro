---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VideoCard from '../../../components/VideoCard.astro';
import { learningPaths } from '../../../lib/youtube';
import type { LearningPath } from '../../../lib/youtube';
export function getStaticPaths() {
  return learningPaths.map(path => ({ params: { slug: path.slug }, props: { path } }));
}
const { path } = Astro.props as { path: LearningPath };
---
<BaseLayout title={path.title} description={path.description || `Explore ${path.title}, a ${path.platform} learning path by Ram Vegiraju.`} active="videos">
  <div class="container path-page">
    <a class="back-link" href="/videos/?view=paths">All learning paths</a>
    <header class="path-header"><p class="eyebrow">{path.platform} · Learning path</p><h1 class="page-title">{path.title}</h1>{path.description && <p class="lede">{path.description}</p>}<p class="path-summary">{path.videos.length} {path.videos.length === 1 ? 'video' : 'videos'} · Follow the playlist order or start with any lesson</p><a class="button" href={`https://www.youtube.com/playlist?list=${path.id}`} target="_blank" rel="noopener noreferrer">Open playlist on YouTube</a></header>
    {(path.audience || path.prerequisites) && <aside class="path-context">{path.audience && <div><h2>Who it’s for</h2><p>{path.audience}</p></div>}{path.prerequisites && <div><h2>Before you start</h2><p>{path.prerequisites}</p></div>}</aside>}
    <div class="curriculum-header"><h2 class="section-heading">In this learning path</h2><p>Video order is maintained on YouTube.</p></div>
    <ol class="curriculum">{path.videos.map((video, index) => <li><div class="lesson-number">Lesson {index + 1}</div><VideoCard video={video} featured /></li>)}</ol>
    <footer class="path-footer"><a class="text-link" href="/videos/?view=paths">Explore more learning paths</a></footer>
  </div>
</BaseLayout>
<style>
  .path-page { padding-top: 58px; padding-bottom: 60px; }
  .back-link { color: var(--muted); text-underline-offset: 5px; font-size: .9375rem; }
  .path-header { max-width: 830px; margin-top: 48px; margin-bottom: 50px; }
  .path-header .page-title { font-size: clamp(2.5rem, 6vw, 4.2rem); }
  .path-header .lede { white-space: pre-line; }
  .path-summary { color: var(--muted); font-size: .9375rem; margin: 24px 0; }
  .path-context { display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; padding: 30px; border: 1px solid var(--border); background: var(--surface); margin-bottom: 60px; }
  .path-context h2 { font: inherit; font-weight: 600; margin: 0 0 12px; }
  .path-context p { margin: 0; line-height: 1.7; color: var(--muted); }
  .curriculum-header { display: flex; justify-content: space-between; gap: 24px; align-items: baseline; border-top: 1px solid var(--border); padding-top: 28px; margin-bottom: 32px; }
  .curriculum-header p { color: var(--muted); font-size: .875rem; }
  .curriculum { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 44px 30px; padding: 0; list-style: none; }
  .curriculum li { min-width: 0; }
  .lesson-number { color: var(--muted); font-size: .875rem; margin-bottom: 12px; }
  .path-footer { border-top: 1px solid var(--border); padding-top: 32px; margin-top: 58px; }
  @media (max-width: 650px) { .path-page { padding-top: 35px; } .path-header { margin-top: 34px; } .curriculum,.path-context { grid-template-columns: 1fr; } .curriculum-header { display: block; } }
</style>
