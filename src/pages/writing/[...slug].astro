---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublished } from '../../content/publication';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => isPublished(data));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const minutes = Math.max(1, Math.ceil((post.body || '').split(/\s+/).length / 220));
---

<BaseLayout title={post.data.title} description={post.data.description} active="writing" type="article" publishedTime={post.data.date.toISOString()} image={post.data.image || undefined} imageAlt={post.data.image ? (post.data.imageAlt || post.data.title) : 'Ram Vegiraju'}>
  <article class="container article-container">
    <a class="text-link back-link" href="/writing/">All writing</a>
    <header class="article-header">
      <div class="article-topics">{post.data.topics.map((topic) => <a href={`/writing/?topic=${encodeURIComponent(topic)}`}>{topic}</a>)}</div>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
      <div class="article-meta"><span>Ram Vegiraju</span><span aria-hidden="true">/</span><time datetime={post.data.date.toISOString()}>{date}</time><span aria-hidden="true">/</span><span>{minutes} min read</span></div>
    </header>
    {post.data.image && <figure class="article-image"><img src={post.data.image} alt={post.data.imageAlt || ''} /></figure>}
    <div class="prose"><Content /></div>
    <footer class="article-footer"><p>Thanks for reading.</p><div><a class="text-link" href="/writing/">Explore the journal</a><a class="text-link" href="/rss.xml">Subscribe via RSS</a></div></footer>
  </article>
</BaseLayout>

<style>
  .article-container{max-width:780px;padding-top:3rem;padding-bottom:5rem}.back-link{font-size:.9rem}.article-header{padding:3rem 0 2.5rem;border-bottom:1px solid var(--border,#34404e)}.article-topics{display:flex;gap:.8rem}.article-topics a{font-size:.875rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent,#E8A87C);text-decoration:none}.article-topics a:hover{text-decoration:underline}.article-header h1{font-family:var(--serif,Georgia,serif);font-weight:400;font-size:clamp(2.5rem,6vw,4rem);line-height:1.12;letter-spacing:-.035em;margin:1rem 0 1.3rem}.article-deck{font-size:1.15rem;line-height:1.7;color:var(--muted,#A8B3C2);margin:0;max-width:42rem}.article-meta{display:flex;gap:.7rem;flex-wrap:wrap;color:var(--muted,#A8B3C2);font-size:.875rem;margin-top:1.8rem}.article-image{margin:2rem 0}.article-image img{display:block;width:100%;height:auto;border-radius:4px}.prose{font-family:Georgia,serif;font-size:1.18rem;line-height:1.9;padding:1.75rem 0 2.5rem}.prose :global(p){margin:1.4rem 0}.prose :global(h2){font-size:1.8rem;line-height:1.3;font-weight:400;letter-spacing:-.015em;margin:2.5rem 0 1rem}.prose :global(h3){font-size:1.4rem;line-height:1.4;font-weight:500;margin:2rem 0 .8rem}.prose :global(a){color:var(--accent,#E8A87C);text-decoration-thickness:1px;text-underline-offset:.2em}.prose :global(a:hover){text-decoration-thickness:2px}.prose :global(li){padding-left:.25rem;margin:.6rem 0}.prose :global(ul),.prose :global(ol){padding-left:1.5rem}.prose :global(blockquote){border-left:2px solid var(--accent,#E8A87C);margin:2rem 0;padding:.1rem 0 .1rem 1.5rem;color:var(--muted,#A8B3C2);font-style:italic}.prose :global(img){max-width:100%;height:auto;border-radius:4px}.prose :global(pre){padding:1.2rem;font-size:.9rem;overflow-x:auto;border:1px solid var(--border,#34404e);border-radius:4px;line-height:1.7}.prose :global(code){font-size:.85em}.prose :global(table){display:block;overflow:auto;border-collapse:collapse;width:100%;font-family:var(--sans,system-ui,sans-serif);font-size:.9rem}.prose :global(th),.prose :global(td){padding:.7rem;border:1px solid var(--border,#34404e);text-align:left}.prose :global(hr){border:0;border-top:1px solid var(--border,#34404e);margin:2.5rem 0}.article-footer{border-top:1px solid var(--border,#34404e);padding-top:2rem}.article-footer p{font-family:var(--serif,Georgia,serif);font-size:1.5rem;margin:0 0 1.2rem}.article-footer div{display:flex;gap:1.5rem;flex-wrap:wrap;font-size:.9rem}@media(max-width:600px){.article-container{padding-top:2rem}.article-header{padding-top:2rem}.article-meta{gap:.5rem;font-size:.875rem}.prose{font-size:1.1rem}}
</style>
