---
import BaseLayout from '../layouts/BaseLayout.astro';
const roles = [
  { company: 'Databricks', role: 'Senior Applied ML Engineer', dates: '2026 — Present', text: 'Working deeply in model serving, agentic systems and evaluation, and distributed training, while continuing to learn and grow in these areas.' },
  { company: 'Amazon Web Services', role: 'ML Architect → Senior ML Architect & Inference Lead', dates: '2021 — 2025', text: 'On the SageMaker service team, I worked with customers and engineering teams on model deployment, inference performance, foundation model evaluation, and product launches.' },
  { company: 'Interview Kickstart', role: 'Generative AI Technical Instructor', dates: '2024 — Present', text: 'Teaching applied generative AI, including agents, retrieval, and cloud architectures, to students from technical and business backgrounds.' },
];
---
<BaseLayout active="professional" title="Professional — Ram Vegiraju" description="Ram Vegiraju’s work in applied ML, model serving, agentic systems, evaluation, distributed training, and teaching.">
  <section class="about-intro container"><div><span class="eyebrow">Work, experience & teaching</span><h1 class="page-title">The professional side<span>.</span></h1><p class="lede">I’m a Senior Applied ML Engineer at Databricks (ex-AWS).</p><p>I’ve worked pretty deeply in model serving, agentic systems and evaluations, and distributed training, and I’m continuing to grow in these areas. Here’s a closer look at that work, along with my experience teaching generative AI.</p><div class="about-links"><a class="button" href="/resume.pdf">Download my resume</a><a class="text-link" href="https://www.linkedin.com/in/ram-vegiraju-81272b162/">Connect on LinkedIn</a></div></div></section>
  <section class="focus-areas container" aria-label="Areas of focus"><div><span class="eyebrow">Building & serving</span><h2>Model serving</h2></div><div><span class="eyebrow">Agents & evaluation</span><h2>Agentic systems</h2></div><div><span class="eyebrow">Training at scale</span><h2>Distributed training</h2></div></section>
  <section class="experience container"><div class="section-heading"><div><span class="eyebrow">The professional chapter</span><h2>Work & experience</h2></div><span class="small-note">A few highlights. The full story is in my resume.</span></div><div class="career-list">{roles.map(role=><article class="career-row"><div><h3>{role.company}</h3><span>{role.dates}</span></div><div><h4>{role.role}</h4><p>{role.text}</p></div></article>)}</div></section>
  <section class="education container"><div><span class="eyebrow">Always learning</span><h2>Education</h2></div><div><article><h3>University of Pennsylvania</h3><p>Master of Computer and Information Technology<br /><span>Expected December 2026</span></p></article><article><h3>University of Virginia</h3><p>B.A. Statistics · Biostatistics concentration<br /><span>December 2020</span></p></article></div></section>
  <section class="elsewhere container"><div><span class="eyebrow">Beyond this website</span><h2>Find me elsewhere.</h2></div><div class="elsewhere-grid"><a href="https://www.youtube.com/@RamVegiraju"><span class="channel-icon">▶</span><h3>YouTube</h3><p>Videos, explanations, and learning paths.</p><span class="text-link">@RamVegiraju</span></a><a href="https://github.com/RamVegiraju"><span class="channel-icon code">{`</>`}</span><h3>GitHub</h3><p>Code, examples, and things I’m building.</p><span class="text-link">RamVegiraju</span></a><a href="https://ram-vegiraju.medium.com/"><span class="channel-icon serif">m.</span><h3>Medium</h3><p>More of my previously published writing.</p><span class="text-link">Read on Medium</span></a></div></section>
</BaseLayout>
<style>
  .about-intro{padding-top:5rem}.about-intro>div{max-width:860px}.about-intro h1 span{color:var(--accent)}.about-intro>div>p:not(.lede){font-size:.95rem;line-height:1.9}.about-links{display:flex;align-items:center;gap:1.6rem;margin-top:2rem}.experience{padding-top:5rem}.small-note{font-size:.75rem;color:var(--muted);max-width:200px}.career-row{display:grid;grid-template-columns:1fr 2fr;gap:3rem;border-top:1px solid var(--border);padding:2rem 0}.career-row:last-child{border-bottom:1px solid var(--border)}.career-row h3{font-size:1.1rem;margin-bottom:.7rem}.career-row>div>span{font-size:.8rem;color:var(--muted)}.career-row h4{font-size:1rem;font-weight:500;margin:0 0 .8rem}.career-row p{font-size:.9rem;max-width:650px;line-height:1.9;margin:0}.education{display:grid;grid-template-columns:1fr 2fr;gap:3rem;padding-block:3rem;border-bottom:1px solid var(--border)}.education h2,.elsewhere h2{font-family:var(--serif);font-size:2.8rem;font-weight:400}.education>div:last-child{display:grid;grid-template-columns:1fr 1fr;gap:2rem}.education h3{font-size:1rem;margin-bottom:.8rem}.education p{font-size:.85rem;line-height:1.9}.education p span{font-size:.75rem}.elsewhere{padding-top:4rem}.elsewhere-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.elsewhere-grid>a{padding:1.7rem;border:1px solid var(--border);border-radius:6px;transition:background .2s,border-color .2s}.elsewhere-grid>a:hover{background:var(--surface);border-color:var(--accent);color:var(--text)}.channel-icon{color:var(--accent);font-size:1.4rem;display:block;height:45px}.channel-icon.code{font-size:1.2rem;font-family:monospace}.channel-icon.serif{font-family:var(--serif);font-size:2.3rem;line-height:1}.elsewhere-grid h3{font-size:1.15rem;margin-bottom:.8rem}.elsewhere-grid p{font-size:.85rem;min-height:45px}.elsewhere-grid .text-link{font-size:.78rem}
  .about-intro .page-title{font-size:clamp(3rem,7vw,5.5rem)}.focus-areas{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding-block:2rem;margin-top:3.5rem}.focus-areas h2{font-family:var(--serif);font-size:2rem;margin-bottom:0}.focus-areas .eyebrow{font-size:.875rem;margin-bottom:.7rem}@media(max-width:760px){.focus-areas{grid-template-columns:1fr;gap:1.6rem}}
  @media(max-width:760px){.about-intro{padding-top:3rem;grid-template-columns:1fr;gap:2rem}.about-links{gap:1rem;flex-wrap:wrap}.experience{padding-top:3.5rem}.small-note{display:none}.career-row{grid-template-columns:1fr;gap:1rem}.education{grid-template-columns:1fr;gap:1rem}.education>div:last-child{grid-template-columns:1fr;gap:1rem}.elsewhere-grid{grid-template-columns:1fr}.elsewhere-grid p{min-height:0}.education h2{margin-bottom:.7rem}}
</style>
