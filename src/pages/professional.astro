---
import BaseLayout from '../layouts/BaseLayout.astro';
const roles = [
  { company: 'Databricks', role: 'Senior Applied ML Engineer', dates: '2026 — Present', text: 'Production AI deployments and product development across Agent Serving, LLM evaluation, AI Runtime, and custom LLM serving and training.' },
  { company: 'Amazon Web Services', role: 'ML Architect → Senior ML Architect & Inference Lead', dates: '2021 — 2025', text: 'Amazon SageMaker inference architecture and product development, including vLLM containers, multi-model hosting, Serverless Inference, and foundation model evaluation.' },
  { company: 'Interview Kickstart', role: 'Generative AI Technical Instructor', dates: '2024 — Present', text: 'Teach applied generative AI, multi-agent workflows, and cloud RAG to technical and business audiences.' },
];
const techStack = [
  { category: 'Languages', tools: ['Python', 'SQL', 'Java', 'C++', 'Bash', 'R', 'JavaScript'] },
  { category: 'Platforms & services', tools: ['Databricks', 'AWS', 'Amazon SageMaker', 'Amazon Bedrock'] },
  { category: 'Model serving', tools: ['vLLM', 'NVIDIA Triton', 'SGLang', 'TorchServe'] },
  { category: 'ML & training', tools: ['PyTorch', 'Transformers', 'TensorFlow', 'scikit-learn', 'XGBoost'] },
  { category: 'Agent frameworks', tools: ['LangChain', 'LangGraph', 'LlamaIndex', 'CrewAI', 'Strands'] },
  { category: 'Evaluation & tools', tools: ['MLflow', 'Locust', 'Docker', 'Git'] },
];
---
<BaseLayout active="professional" title="Professional — Ram Vegiraju" description="Ram Vegiraju’s work in applied ML, model serving, agentic systems, evaluation, distributed training, and teaching.">
  <section class="about-intro container"><div><h1 class="page-title">Professional<span>.</span></h1><p class="lede">I’m a Senior Applied ML Engineer at Databricks (ex-AWS).</p><p>My work covers model serving, agentic systems and evaluation, distributed training, and technical education.</p><div class="about-links"><a class="button" href="/resume.pdf">Download my resume</a><a class="text-link" href="https://www.linkedin.com/in/ram-vegiraju-81272b162/">Connect on LinkedIn</a></div></div></section>

  <section class="experience container"><div class="section-heading"><div><h2>Experience</h2></div></div><div class="career-list">{roles.map(role=><article class="career-row"><div><h3>{role.company}</h3><span>{role.dates}</span></div><div><h4>{role.role}</h4><p>{role.text}</p></div></article>)}</div></section>
  <section class="tech-stack container" aria-labelledby="tech-stack-title"><h2 id="tech-stack-title">Tech Stack</h2><div class="stack-grid">{techStack.map(group => <section class="stack-group" aria-label={group.category}><h3>{group.category}</h3><ul>{group.tools.map(tool => <li>{tool}</li>)}</ul></section>)}</div></section>
  <section class="education container"><div><h2>Education</h2></div><div><article><h3>University of Pennsylvania</h3><p><a class="degree-link" href="https://online.engineering.upenn.edu/degrees/mas-cs/" target="_blank" rel="noopener noreferrer">Master of Applied Science in Computer Science (MAS-CS)</a><br /><span>December 2024–December 2026</span></p></article><article><h3>University of Virginia</h3><p>B.A. Statistics · Biostatistics concentration<br /><span>August 2017–December 2020</span></p></article></div></section>
  <section class="elsewhere container"><div><h2>Links</h2></div><div class="elsewhere-grid"><a href="https://www.youtube.com/@RamVegiraju"><span class="channel-icon">▶</span><h3>YouTube</h3><p>Videos, explanations, and learning paths.</p><span class="text-link">@RamVegiraju</span></a><a href="https://github.com/RamVegiraju"><span class="channel-icon code">{`</>`}</span><h3>GitHub</h3><p>Code, examples, and things I’m building.</p><span class="text-link">RamVegiraju</span></a><a href="https://ram-vegiraju.medium.com/"><span class="channel-icon serif">m.</span><h3>Medium</h3><p>Articles and technical posts.</p><span class="text-link">Read on Medium</span></a></div></section>
</BaseLayout>
<style>
  .degree-link{color:var(--text);text-decoration:underline;text-decoration-color:var(--border);text-underline-offset:4px}.degree-link:hover{color:var(--accent);text-decoration-color:var(--accent)}
  .about-intro{padding-top:5rem}.about-intro>div{max-width:860px}.about-intro h1 span{color:var(--accent)}.about-intro>div>p:not(.lede){font-size:.95rem;line-height:1.9}.about-links{display:flex;align-items:center;gap:1.6rem;margin-top:2rem}.experience{padding-top:5rem}.career-row{display:grid;grid-template-columns:1fr 2fr;gap:3rem;border-top:1px solid var(--border);padding:2rem 0}.career-row:last-child{border-bottom:1px solid var(--border)}.career-row h3{font-size:1.1rem;margin-bottom:.7rem}.career-row>div>span{font-size:.875rem;color:var(--muted)}.career-row h4{font-size:1rem;font-weight:500;margin:0 0 .8rem}.career-row p{font-size:.9rem;max-width:650px;line-height:1.9;margin:0}.education{display:grid;grid-template-columns:1fr 2fr;gap:3rem;padding-block:3rem;border-bottom:1px solid var(--border)}.education h2,.elsewhere h2{font-family:var(--serif);font-size:2.8rem;font-weight:400}.education>div:last-child{display:grid;grid-template-columns:1fr 1fr;gap:2rem}.education h3{font-size:1rem;margin-bottom:.8rem}.education p{font-size:.95rem;line-height:1.9}.education p span{font-size:.875rem}.elsewhere{padding-top:4rem}.elsewhere-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.elsewhere-grid>a{padding:1.7rem;border:1px solid var(--border);border-radius:6px;transition:background .2s,border-color .2s}.elsewhere-grid>a:hover{background:var(--surface);border-color:var(--accent);color:var(--text)}.channel-icon{color:var(--accent);font-size:1.4rem;display:block;height:45px}.channel-icon.code{font-size:1.2rem;font-family:monospace}.channel-icon.serif{font-family:var(--serif);font-size:2.3rem;line-height:1}.elsewhere-grid h3{font-size:1.15rem;margin-bottom:.8rem}.elsewhere-grid p{font-size:.85rem;min-height:45px}.elsewhere-grid .text-link{font-size:.875rem}
  .about-intro .page-title{font-size:clamp(3rem,7vw,5.5rem)}.tech-stack{padding-block:3rem;border-bottom:1px solid var(--border)}.tech-stack>h2{font-family:var(--serif);font-size:2.8rem;font-weight:400;margin-bottom:2rem}.stack-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2.5rem 2rem}.stack-group h3{font-size:1rem;color:var(--accent);font-weight:500;margin-bottom:1rem}.stack-group ul{display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;padding:0;margin:0}.stack-group li{font-size:.875rem;color:var(--text);border:1px solid var(--border);border-radius:4px;padding:.35rem .7rem;background:var(--surface)}@media(max-width:900px){.stack-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:540px){.stack-grid{grid-template-columns:1fr;gap:1.8rem}}
  @media(max-width:760px){.about-intro{padding-top:3rem;grid-template-columns:1fr;gap:2rem}.about-links{gap:1rem;flex-wrap:wrap}.experience{padding-top:3.5rem}.career-row{grid-template-columns:1fr;gap:1rem}.education{grid-template-columns:1fr;gap:1rem}.education>div:last-child{grid-template-columns:1fr;gap:1rem}.elsewhere-grid{grid-template-columns:1fr}.elsewhere-grid p{min-height:0}.education h2{margin-bottom:.7rem}}
</style>
