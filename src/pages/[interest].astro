---
import BaseLayout from '../layouts/BaseLayout.astro';
import { interests } from '../data/interests.json';
import { getCollection } from 'astro:content';
import { isPublished } from '../content/publication';
import BoxingJourney from '../components/BoxingJourney.astro';

export function getStaticPaths() {
  return interests.map(interest => ({ params: { interest: interest.slug }, props: { interest } }));
}
const { interest } = Astro.props;
const posts = (await getCollection('posts', ({data}) => isPublished(data) && data.topics.includes(interest.topic)))
  .sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={interest.title} description={interest.description} active={interest.slug}>
  <section class="container interest-header">
    <span class="eyebrow">{interest.slug === 'boxing' ? 'Boxing & combat sports' : 'A little more of my life'}</span>
    <h1 class="page-title">{interest.heading}</h1>
    <p class="lede">{interest.description}</p>
  </section>
  {interest.slug === 'boxing' ? <BoxingJourney /> : <section class="container interest-content" aria-label={`About my interest in ${interest.title}`}>
    <span class="interest-label">{interest.title}</span>
    <div>{interest.intro.split(/\n\s*\n/).map(paragraph => <p>{paragraph}</p>)}</div>
  </section>}
  <section class="container interest-journal">
    <div class="section-heading"><div><span class="eyebrow">From the journal</span><h2>Notes on {interest.title.toLowerCase()}</h2></div><a class="text-link" href={`/writing/?topic=${encodeURIComponent(interest.topic)}`}>View in Writing</a></div>
    {posts.length > 0 ? <div class="interest-posts">{posts.map(post => <article><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><h3><a href={`/writing/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="text-link" href={`/writing/${post.id}/`}>Read entry</a></article>)}</div> : <div class="empty-state"><h3>More to share as I go.</h3><p>I haven’t published any {interest.title.toLowerCase()} posts yet. This is where they’ll appear.</p><a class="text-link" href="/writing/">Explore the journal</a></div>}
  </section>
</BaseLayout>
<style>
  .interest-header{padding-block:5rem 3rem}.interest-header .page-title{max-width:900px;font-size:clamp(3rem,7vw,5.8rem);overflow-wrap:break-word}.interest-content{display:grid;grid-template-columns:1fr 2fr;gap:3rem;padding-block:2.5rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.interest-label{font-size:1rem;color:var(--accent)}.interest-content p{font-size:1.1rem;line-height:1.9;max-width:700px}.interest-content p:last-child{margin-bottom:0}.interest-journal{padding-top:4rem}.interest-posts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2.5rem}.interest-posts article{padding-top:1.5rem;border-top:1px solid var(--border)}.interest-posts time{font-size:.875rem;color:var(--muted)}.interest-posts h3{font-family:var(--serif);font-size:2rem;margin:1rem 0}.empty-state{padding:2.5rem}.empty-state h3{font-family:var(--serif);font-size:2rem}.empty-state p{margin-bottom:1.5rem}@media(max-width:760px){.interest-header{padding-top:3rem;margin-inline:auto}.interest-content,.interest-posts{grid-template-columns:1fr;gap:1rem}.interest-journal .section-heading{align-items:start;flex-direction:column}.interest-content p{font-size:1rem}}
</style>
