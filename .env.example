# Public canonical origin; replace before a public production deployment.
SITE_URL=https://your-domain.example

# Server-only Netlify Functions variables. Never prefix with PUBLIC_.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# public_repo for the current public repo; change to repo if made private.
GITHUB_OAUTH_SCOPE=public_repo

# Build/sync-only secret; no Google OAuth credentials are needed.
YOUTUBE_API_KEY=
