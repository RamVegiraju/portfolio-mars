    "sync:youtube": "node scripts/sync-youtube.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/leaflet": "^1.9.22",
    "typescript": "^5.9.0"
  }
